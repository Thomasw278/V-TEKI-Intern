# Salin menjadi .env lalu sesuaikan.
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE?charset=utf8mb4
DATABASE_URL=mysql+pymysql://karbon:karbon123@localhost:3306/karbonlens?charset=utf8mb4

# Wajib diganti di server produksi (minimal 32 karakter acak)
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRE_HOURS=12

# Folder penyimpanan berkas unggahan
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50

# Alamat frontend yang boleh mengakses API (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OCR untuk dokumen hasil scan/foto. Kosongkan bila `tesseract` sudah ada di PATH.
# Windows: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
